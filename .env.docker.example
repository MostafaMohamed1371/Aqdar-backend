# Docker environment — copy to .env.docker and adjust if needed
# Used by: docker compose up

APP_NAME=AQDAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aqdar
DB_USERNAME=aqdar
DB_PASSWORD=secret
DB_CHARSET=utf8
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_ALLOWED_EMAILS=test@example.com

MAIL_MAILER=log

FRONTEND_URL=http://localhost:3000
STRUCTER_API_PREFIX=v1

SALES_PHONE=
SALES_TEAM_NAME="فريق مبيعات عَقدار"

# Trust nginx proxy
TRUSTED_PROXIES=*
