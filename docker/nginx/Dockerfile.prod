# Production nginx — static assets from app image + load-balanced PHP-FPM upstream
ARG APP_IMAGE=ghcr.io/your-org/structer-laravel:latest
FROM ${APP_IMAGE} AS app-source

FROM nginx:1.27-alpine

COPY --from=app-source /var/www/html/public /var/www/html/public
COPY docker/nginx/load-balancer.conf /etc/nginx/conf.d/default.conf
