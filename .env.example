APP_NAME=AQDAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo

# Production: set APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.com
# FORCE_HTTPS=true
# SECURITY_HSTS=true
# SESSION_ENCRYPT=true
# LOG_LEVEL=error

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aqdar
DB_USERNAME=aqdar
DB_PASSWORD=
# PHPUnit uses a separate Postgres database (phpunit.xml): aqdar_eg_testing
DB_CHARSET=utf8
DB_SSLMODE=prefer
# DB_READ_HOST=
# DB_WRITE_HOST=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_PRIVATE_DISK=local
FILESYSTEM_PUBLIC_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_PATH=/reset-password
STRUCTER_API_PREFIX=v1

# Platform Sales contact (never commit a real production number)
SALES_PHONE=
SALES_TEAM_NAME="فريق مبيعات عَقدار"
SALES_HOURS="يومياً 10ص – 10م"
AQDAR_LEAD_ASSIGNMENT_RULE=manual
AQDAR_PLATFORM_NAME=AQDAR
AQDAR_SUPPORT_EMAIL=support@aqdar.eg
AQDAR_AUDIT_RETENTION_MONTHS=24

# Local OTP uses the log/cache driver. Never return the code in API responses.
# AQDAR_OTP_TTL=300
# AQDAR_OTP_RESEND_AFTER=45
# AQDAR_OTP_MAX_ATTEMPTS=5
# AQDAR_OTP_DECAY_MINUTES=10
# AQDAR_SMS_DRIVER=log
# AQDAR_SMS_HTTP_URL=
# AQDAR_SMS_HTTP_TOKEN=
# SANCTUM_EXPIRATION_MINUTES=43200
# AQDAR_CONSENT_VERSION=1
# AQDAR_TERMS_URL=
# AQDAR_PRIVACY_URL=

# Security rate limits (attempts per decay window)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_DECAY_MINUTES=1
# API_AUTH_MAX_ATTEMPTS=10
# API_AUTH_DECAY_MINUTES=1
# PASSWORD_RESET_MAX_ATTEMPTS=3
# PASSWORD_RESET_DECAY_MINUTES=1

# Production scaling (Redis + Horizon + load-balanced app servers)
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# DB_READ_HOST=read-replica.example.com
# DB_WRITE_HOST=primary.example.com
# FILESYSTEM_DISK=s3
# HORIZON_ALLOWED_EMAILS=admin@example.com
# PAYMENT_MAX_ATTEMPTS=10
# PAYMENT_DECAY_MINUTES=1
# STRUCTER_RESERVATION_MINUTES=10

AQDAR_BACKUP_PATH=
AQDAR_PG_DUMP=

# Push: log (default, tests/local) or fcm (HTTP v1). Do not commit the service-account JSON.
AQDAR_PUSH_DRIVER=log
# AQDAR_PUSH_DRIVER=fcm
# AQDAR_FCM_CREDENTIALS=
# AQDAR_FCM_PROJECT_ID=
# AQDAR_FCM_CLIENT_EMAIL=
# AQDAR_FCM_PRIVATE_KEY=
